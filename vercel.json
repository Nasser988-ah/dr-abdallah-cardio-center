{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemaps/pages.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/xml-sitemap",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/xml-sitemap/",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml/", "destination": "/sitemap.xml" },
    { "source": "/sitemaps/pages.xml/", "destination": "/sitemaps/pages.xml" },
    { "source": "/api/sitemap/", "destination": "/api/sitemap" }
  ],
  "redirects": [
    { "source": "/sitemap", "destination": "/html-sitemap/", "permanent": true },
    { "source": "/sitemap/", "destination": "/html-sitemap/", "permanent": true },
    { "source": "/en/sitemap", "destination": "/en/html-sitemap/", "permanent": true },
    { "source": "/en/sitemap/", "destination": "/en/html-sitemap/", "permanent": true }
  ]
}
